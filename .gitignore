# Datavalimuisti — voi olla iso, ei kuulu repoon
# Huom: /data/ alussa = vain projektin juuren data/, EI src/data/
# /data/* ignoroi sisällön mutta sallii poikkeukset (vendoroitu WC-data #79).
raw_data/
/data/*
# Poikkeukset: vendoroitu martj42-maaotteludata (CC0) kuuluu repoon — Render
# buildaa gitistä, ei live-pullia ajossa.
!/data/international_results.csv
!/data/international_results.README.md
# Esirakennettu WC-malli (#79) — vendoroitu, ladataan ajossa (ei fittiä Renderillä).
!/data/wc_model.json
# Vendoroitu World Football Elo -snapshot (#79 konfederaatio-kalibrointi).
!/data/elo_ratings.csv
# Tarkkuus-track-record (#100): ajastettu putki ylläpitää, Render lukee gitistä.
!/data/prediction_log.json
!/data/accuracy.json
# FPL Phase 0 -projektio: ajastettu refresh ylläpitää, Render lukee gitistä (/api/fantasy).
!/data/fpl_projections_phase0.json
# SPL-fantasy Phase 0 (7.8): vendoroitu tuloshistoria (ESPN, DC-priorifitti)
# + baked output. Sama !-kuvio kuin FPL:ssä — ilman näitä builderi toimisi
# vain kehityskoneella ja endpoint 503:aisi tuotannossa.
!/data/spl_results.csv
!/data/spl_results.README.md
!/data/spl_projections_phase0.json
!/data/spl_xp_projections.json
# 13.8: availability-overridet OSA LAHDEKOODIA - ilman tata CI-refresh
# rebuildaa squadin ilman korjausta ja peruu sen hiljaa 3 h valein
!/data/spl_availability_overrides.json
# xP-backtestin tiiviste (26.7): rate-team-selite kertoo projektioiden
# osuvuuden, ja taysi raportti on logs/-alla gitignorattuna -> Render lukee taman.
!/data/fpl_xp_accuracy.json
# FPL Phase 1 xP -projektio: sama refresh-konventio (/api/fantasy/xp).
!/data/fpl_xp_projections.json
# Koko kauden 380 fixturen CS/FDR/1X2 (chip-EV lukee Renderilla gitista;
# ilman tata chip-ev degradoituu 6 GW:n ikkunaan).
!/data/fpl_cs_fdr.json
# Jäädytetyt 25/26-pelaajabaselinet (element code -avain) — pre-season-xP:n
# lähde 26/27-flipin jälkeen (scripts/build_fpl_prev_baselines.py); CI
# tarvitsee tämän repossa (25/26-data ei enää haettavissa API:sta).
!/data/fpl_prev_baselines_2526.json
# FPL Phase 1b: manuaaliset konteksti-yliajot (versioitu input, builderit lukevat).
!/data/fpl_manual_overrides.csv
# 28.7: PELAAJATASON minuuttiohitukset. Tama poikkeus PUUTTUI kun tiedosto
# luotiin 27.7 -> se jai vain kehityskoneelle, CI-runnerilla sita ei ollut, ja
# load_player_overrides() palautti hiljaa tyhjan dictin. Seuraus: 27.7 korjattu
# Isak (6.34 -> 18.93) oli tuotannossa yha 6.34. Sama refresh-konventio kuin
# muilla versioiduilla inputeilla: builderi lukee taman gitista.
!/data/fpl_player_overrides.csv
# #142 OSA A: PL-seura->MM-2026-minuuttikartta (versioitu artefakti, OSA B:n
# mitoitusevidenssi; uusinta-ajo ~15.8 ennen GW1:ta).
!/data/wc2026_club_load.csv
# FPL price watch (#43): sama refresh-konventio (/api/fantasy/price-watch).
!/data/fpl_price_watch.json

# #124/#125: xG- + DefCon-leaders-cache (committattu → Render servaa levyltä)
!/data/fpl_player_leaders.json

# 8.8 STATS-ZONE vaihe 2: Understatin laukausaggregaatti. Päättynyt kausi on
# staattinen, joten artefakti rakennetaan kerran lokaalisti ja committataan —
# CI ei hae 380 ottelusivua eikä altista GH-runnerin IP:tä estoille.
!/data/understat_player_shots_2526.json
!/data/understat_team_defence_2526.json

# 8.8 STATS-ZONE: /fpl/stats -sivun lähdedata (scripts/build_fpl_stats.py).
# Ilman tätä !-poikkeusta tiedosto jää kehityskoneelle ja CI:n regenerointi
# tuottaisi sivun tyhjästä datasta — sama vikaluokka kuin fpl_defcon_gw.
!/data/fpl_player_stats.json

# 30.7: per-GW DefCon -matriisi (committattu → Render servaa levyltä).
# HUOM: ilman tätä !-poikkeusta endpoint 503:aa tuotannossa vaikka kaikki
# muu on pushattu — gitignoroitu-korjaus-vikaluokka.
!/data/fpl_defcon_gw.json

# 30.7: julkiset tarkkuuslokit + xP-deadline-freezet (append-only, CI kirjoittaa)
!/data/fpl_price_accuracy.json
!/data/fpl_xp_gw_accuracy.json
!/data/fpl_xp_frozen/
!/data/fpl_xp_frozen/*.json

# 13.8 (Beat the Model V2 vaihe a): mallin joukkueen deadline-freeze.
# Koko V2:n julkinen vaite on "logged before kickoff, todistettavissa
# git-historiasta" — ilman tata !-poikkeusta freeze kirjoittuisi levylle,
# git add ohittaisi sen aanettomasti (vrt. founder_entry.json alla) ja
# vaite olisi todistamaton juuri silla mekanismilla jolla se myydaan.
!/data/model_squad_frozen/
!/data/model_squad_frozen/*.json
# Vaihe b: gradatut pisteet (append-only). Sama peruste kuin freezella —
# Season race -paneeli lukee taman, ja ilman !-poikkeusta luku eläisi vain
# runnerilla eika koskaan paatyisi sivulle.
!/data/model_squad_gw_scores.json

# 14.8 (PUSH-NOTIF vaihe b): push_dispatchin idempotenssimarkkerit.
# ILMAN TATA POIKKEUSTA TUPLAPUSHI ON VARMA: markkeri elaisi vain runnerin
# levylla, seuraava runner aloittaisi tyhjasta tilasta ja lahettaisi saman
# deadline-pushin uudelleen. Tiedosto on samalla toimituksen auditointiloki
# (specin kova saanto 5) — sama "logged"-periaate kuin freezeilla yllä.
!/data/push_state.json

# 14.8 (WHY-THIS-PICK): selitykset per pelaaja. Committoidaan kahdesta syysta:
# API servaa taman levylta (kuten projektiot), ja cache-hash elaisi muuten
# vain runnerilla -> jokainen ajo maksaisi taydet Claude-kutsut uudelleen.
!/data/fpl_why.json

# 1.8: perustajalohkon luvut julkisesta entrysta (build_founder_stats.py).
# Tama !-poikkeus PUUTTUI shipatessa -> data-refreshin commit-step kaatui
# "paths are ignored"-virheeseen 4 ajossa (1.-2.8) eika MITAAN dataa pushattu.
# build_fpl_page lukee taman repon puolelta, joten tiedoston on oltava mukana.
!/data/founder_entry.json
downloaded_files/
~/soccerdata/

