outputs/cards/
.env.txt
.env.*
# Pre-season-priorin validointi (9.8.2026): jaadytetyt kausihistoriat, joista
# kesatauko-foldit ajetaan. Raakadata (data/raw/fpl/season_*) on isoa ja jaa
# ignoreen; nama tiivisteet ovat portin syote. Ilman !-poikkeusta portti
# toimisi vain kehityskoneella ja nayttaisi muualla "artefakti puuttuu".
!/data/fpl_prev_season_minutes_*.json
# Joukkueiden luottamuslippu (9.8.2026): builderit ja API lukevat taman, joten
# se on oltava repossa kuten muutkin bake-artefaktit.
!/data/team_confidence.json

# 11.8: generoidut Reels-videot ovat artefakteja, ei lahdekoodia
outputs/reels/
# 14.8: GW-digest-vedokset. EI committoida tarkoituksella: vedos generoidaan
# LAHETYSHETKELLA tuoreesta datasta, ja repossa lojuva viikon vanha vedos on
# tasan se jonka joku lahettaa vahingossa (muisti: verifiointi
# postaushetkella, ei valmisteluhetkella).
outputs/gw_digest/

