+
+def test_attach_why_carries_driver_facts_for_the_listed_drivers_only():
+    from src.models.fpl_xp import attach_why
+    p = _rich_player()
+    entries = {"1": {"sentence": "x", "drivers": ["minutes", "clean_sheets"],
